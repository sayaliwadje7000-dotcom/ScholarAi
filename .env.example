# ScholarAI production environment

SCHOLARAI_ENVIRONMENT=production

# PostgreSQL
POSTGRES_DB=scholarai
POSTGRES_USER=scholarai
POSTGRES_PASSWORD=CHANGE_TO_A_STRONG_PASSWORD

# SQLAlchemy connection
DATABASE_URL=postgresql+psycopg://scholarai:CHANGE_TO_A_STRONG_PASSWORD@db:5432/scholarai

# Frontend
SCHOLARAI_FRONTEND_ORIGIN=https://your-domain.example

# Backend
SCHOLARAI_BACKEND_HOST=0.0.0.0
SCHOLARAI_BACKEND_PORT=8000

# Document storage
DOCUMENT_STORAGE_ROOT=/app/storage
MAX_DOCUMENT_SIZE_BYTES=20971520
MAX_DOCUMENT_PAGES=100
CREATE_DOCUMENT_STORAGE=true

# OCR
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_TIMEOUT_SECONDS=60
OCR_MINIMUM_CONFIDENCE=40
OCR_FORCE=false

# LLM provider
GEMINI_API_KEY=
