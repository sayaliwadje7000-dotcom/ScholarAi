def inspect_required_files() -> dict:
    report = {}

    for phase, files in REQUIRED_FILES.items():

        present = []
        missing = []

        for relative_path in files:

            absolute_path = PROJECT_ROOT / relative_path

            if absolute_path.is_file():
                present.append(relative_path)
            else:
                missing.append(relative_path)

        report[phase] = {
            "expected_files": len(files),
            "present_files": len(present),
            "missing_files": missing,
            "status": (
                "FILES_PRESENT"
                if not missing
                else "FILES_MISSING"
            ),
        }

    return report


def build_audit_report() -> dict:

    phase_results = inspect_required_files()

    expected_count = sum(
        item["expected_files"]
        for item in phase_results.values()
    )

    present_count = sum(
        item["present_files"]
        for item in phase_results.values()
    )

    missing_count = expected_count - present_count

    return {
        "project": "ScholarAI",
        "phase": "16",
        "phase_title": (
            "Personalized Learning and Adaptive Recommendations"
        ),
        "audit_generated_at": datetime.now(
            timezone.utc
        ).isoformat(),
        "repository_root": str(PROJECT_ROOT),
        "file_inventory": phase_results,
        "summary": {
            "expected_files": expected_count,
            "present_files": present_count,
            "missing_files": missing_count,
            "all_expected_files_present": (
                missing_count == 0
            ),
        },
        "integration_gaps": IMPORTANT_INTEGRATION_GAPS,
        "completion_status": (
            "IMPLEMENTATION_INVENTORY_COMPLETE"
            if missing_count == 0
            else "IMPLEMENTATION_INVENTORY_INCOMPLETE"
        ),
        "verification_warning": (
            "File presence does not prove correctness, "
            "runtime compatibility, test success, or production readiness."
        ),
    }


def main():

    report = build_audit_report()

    output_directory = PROJECT_ROOT / "artifacts"

    output_directory.mkdir(
        parents=True,
        exist_ok=True,
    )

    output_file = (
        output_directory
        / "phase_16_10_integration_audit.json"
    )

    output_file.write_text(
        json.dumps(
            report,
            indent=4,
        ),
        encoding="utf-8",
    )

    print("\nScholarAI Phase 16 Integration Audit")
    print("=" * 50)

    for phase, result in report["file_inventory"].items():

        print(
            f"{phase}: {result['status']} "
            f"({result['present_files']}/"
            f"{result['expected_files']})"
        )

        for missing_file in result["missing_files"]:
            print(f"  MISSING: {missing_file}")

    print("\nSummary")
    print("-" * 50)

    print(
        f"Expected files: "
        f"{report['summary']['expected_files']}"
    )

    print(
        f"Present files: "
        f"{report['summary']['present_files']}"
    )

    print(
        f"Missing files: "
        f"{report['summary']['missing_files']}"
    )

    print("\nIntegration gaps")

    for gap in report["integration_gaps"]:
        print(
            f"{gap['id']} | {gap['area']} | "
            f"{gap['status']}"
        )

    print(f"\nReport saved to: {output_file}")

    print(
        "\nNOTE: This audit checks file presence, "
        "not runtime correctness."
    )


if __name__ == "__main__":
    main()